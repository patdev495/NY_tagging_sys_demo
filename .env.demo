# ============================================================
#  NY TAGGING SYSTEM — DEMO ENVIRONMENT
# ============================================================
# Demo mode: bypass ShopFloorDW, fake BarTender print success
DEMO_MODE=true

# SQLite — DB file mounted from host (exported from production)
DATABASE_URL=sqlite:///database.db

# Backend port (internal, Nginx proxies to this)
API_PORT=8001

# PDF export dir (inside container)
PDF_EXPORT_DIR=/app/print_jobs

# Timezone
TZ=Asia/Ho_Chi_Minh

# ============================================================
#  KHÔNG điền DB_SERVER / DB_USER / DB_PASS
#  Demo dùng SQLite, không kết nối MSSQL
# ============================================================
